<?xml version="1.0" encoding="utf-8"?>
<!--
  Icon background.

  A single deep gradient, lit from the top-left like every other surface in
  the app. Kept genuinely simple because the mark on top is doing the work -
  a busy background behind a glass object means you can no longer tell what
  the glass is refracting and what is just pattern.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108">
                <item android:offset="0.0" android:color="#FF1F7CFF" />
                <item android:offset="0.5" android:color="#FF3D5BF0" />
                <item android:offset="1.0" android:color="#FF6A31D9" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- The light source itself, so the glass has something to catch. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="26" android:centerY="18" android:gradientRadius="88">
                <item android:offset="0.0" android:color="#59FFFFFF" />
                <item android:offset="0.55" android:color="#14FFFFFF" />
                <item android:offset="1.0" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
