<?xml version="1.0" encoding="utf-8"?>
<!--
    Two overlapping speech bubbles - a conversation, not a single message.

    The back bubble is translucent and the front one solid, so where they cross
    the colour deepens on its own rather than being painted in. That overlap is
    the whole idea: it only works because the shapes are genuinely see-through,
    which is the same material the app's own surfaces use.

    Drawn inside the middle 72dp of the 108dp canvas, since the launcher crops
    an adaptive icon to varying shapes and anything outside that can be cut.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Back bubble: pale, translucent, tail to the lower right. -->
    <group android:name="back">
        <path
            android:pathData="M55,30h26a11,11 0,0 1,11 11v16a11,11 0,0 1,-11 11h-8l0,9 -8,-9h-10a11,11 0,0 1,-11 -11v-16a11,11 0,0 1,11 -11z"
            android:fillColor="#4A8CFF"
            android:fillAlpha="0.28" />
    </group>

    <!-- Front bubble: solid, tail to the lower left. Drawn second so the
         overlap darkens naturally where the two meet. -->
    <group android:name="front">
        <path
            android:pathData="M27,44h26a11,11 0,0 1,11 11v16a11,11 0,0 1,-11 11h-16l-8,9 0,-9h-2a11,11 0,0 1,-11 -11v-16a11,11 0,0 1,11 -11z"
            android:fillColor="#2F7CF6" />
    </group>
</vector>
