<?xml version="1.0" encoding="utf-8"?>
<!--
  Icon mark: a droplet, with the ripple it just made.

  The droplet is the app's whole motion language - panels swell into place,
  the push lands like something liquid pulling into shape - so the icon says
  the same thing the animations do. Two arcs, not four: at 48dp on a home
  screen anything finer turns to mush, and an icon that only works at full
  size is an illustration, not an icon.

  Everything sits inside the 72dp safe zone, so no launcher's mask can clip
  the mark itself.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer ripple -->
    <path
        android:pathData="M28,74 A26,26 0 0 0 80,74"
        android:strokeColor="#59FFFFFF"
        android:strokeWidth="3.5"
        android:strokeLineCap="round" />

    <!-- Inner ripple -->
    <path
        android:pathData="M37,74 A17,17 0 0 0 71,74"
        android:strokeColor="#8CFFFFFF"
        android:strokeWidth="3.5"
        android:strokeLineCap="round" />

    <!-- The droplet -->
    <path android:pathData="M54,26 C54,26 74,48 74,60 A20,20 0 0 1 34,60 C34,48 54,26 54,26 Z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="40" android:startY="28"
                android:endX="68" android:endY="80">
                <item android:offset="0.0" android:color="#FFFFFFFF" />
                <item android:offset="1.0" android:color="#FFD8E4FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Highlight on the droplet's shoulder, so it reads as wet rather than flat -->
    <path
        android:pathData="M47,47 C44,53 44,60 47,65"
        android:strokeColor="#73FFFFFF"
        android:strokeWidth="4"
        android:strokeLineCap="round" />
</vector>
